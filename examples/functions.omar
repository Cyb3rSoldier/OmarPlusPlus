tika Functions: kaj, ferot, recursion

kaj purno add(purno a, purno b) {
    ferot a jog b;
}

tika no return type means the function returns nothing
kaj greet(lekha who) {
    dekhao "Hello,", who jog "!";
}

kaj sottoMitha isEven(purno n) {
    ferot n vagshesh 2 somoman 0;
}

kaj dosomik average(dosomik a, dosomik b) {
    ferot (a jog b) vagfol 2;
}

greet("Omar");
dekhao "add(3, 4) =", add(3, 4);
dekhao "isEven(10) =", isEven(10);
dekhao "isEven(7) =", isEven(7);
dekhao "average(3, 4) =", average(3, 4);
shesh
